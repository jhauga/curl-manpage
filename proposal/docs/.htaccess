RedirectMatch "^/docs/CURL-(CVE-.*.json)" https://curl.se/docs/$1

# The man page uses a script for the search box in its option menu. This is
# the default CSP with script-src 'self' added.
<FilesMatch "^manpage\.html$">
Header set Content-Security-Policy: "upgrade-insecure-requests; default-src 'none'; base-uri 'none'; script-src 'self'; img-src 'self'; style-src 'unsafe-inline' 'self'; form-action 'self'; frame-ancestors 'none'; require-trusted-types-for 'script';"
</FilesMatch>
